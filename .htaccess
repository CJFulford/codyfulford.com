RewriteEngine on

# remove trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

RewriteRule ^$ index.php
RewriteRule ^career$ career.php
RewriteRule ^development$ development.php
RewriteRule ^volunteering$ volunteering.php
RewriteRule ^renderings$ renderings.php
Options -Indexes
